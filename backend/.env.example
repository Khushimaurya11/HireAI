# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hireai

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Firebase Admin (Google OAuth verification)
# Paste the full contents of your Firebase service-account JSON as one line,
# or point to a file path instead — see config/firebase.js
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenRouter (GPT-4o-mini) — used for resume parsing, question generation & grading
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Credits
SIGNUP_BONUS_CREDITS=100
INTERVIEW_COST_CREDITS=50
